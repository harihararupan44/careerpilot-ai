# =========================================================================
# CAREERPILOT AI - BACKEND PRODUCTION ENVIRONMENT VARIABLES
# =========================================================================
# Copy this file to .env for local development or set these environment
# variables directly in your hosting dashboard (e.g. Render, Railway, AWS).
# IMPORTANT: Never commit your real credentials or API keys to version control.
# =========================================================================

# Server Port (Auto-assigned by hosting provider in production)
PORT=5000

# Node Environment (production | development)
NODE_ENV=production

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/careerpilot?retryWrites=true&w=majority
MONGO_URI=

# JSON Web Token Secret & Expiration
JWT_SECRET=
JWT_EXPIRE=30d

# Frontend Client URL (For CORS Authorization - comma-separated if multiple domains)
# Example: https://careerpilot.vercel.app,https://careerpilot-app.vercel.app
CLIENT_URL=

# AI Career Intelligence Configuration (Module 13)
# Optional: Provide OpenAI/Anthropic/Gemini compatible API Key for live AI queries.
# If omitted, CareerPilot uses its built-in deterministic expert NLP reasoning engine.
AI_API_KEY=
AI_MODEL=gpt-4o-mini